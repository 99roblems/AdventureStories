{
  "name": "tycholabs/adventurestories",
  "dependencies": {},
  "actions": {
    "follow-ticket-changes": {
      "tags": [
        "Ticket to PR"
      ],
      "agent": "claude",
      "model": "claude-haiku-4-5",
      "skill": "tessl/factory#follow-ticket-changes",
      "environment": "factory-tycholabs-adventurestories-follow-ticket-changes"
    },
    "implement": {
      "tags": [
        "Ticket to PR"
      ],
      "agent": "claude",
      "model": "claude-opus-5-5",
      "skill": "tessl/factory#implement-github-issue",
      "concurrency": {
        "keys": [
          {
            "key": "implement:github-issue:{{ inputs.GITHUB_ISSUE_NUMBER }}",
            "limit": 1
          }
        ]
      },
      "environment": "factory-tycholabs-adventurestories-implement"
    },
    "learn-from-agent-runs": {
      "tags": [
        "Learn from past work"
      ],
      "agent": "claude",
      "model": "claude-opus-5-5",
      "skill": "tessl/learn-from-past-work#learn-from-agent-runs",
      "effort": "medium",
      "environment": "improve-tycholabs-adventurestories-778d875f-agent-retro",
      "instructions": "",
      "inputs": {
        "orgId": "019f4dc3-72ed-71ec-b386-f24ff7188c49",
        "projectId": "01a1efa6-49b3-7597-8ea8-fddc778d875f",
        "windowDays": "1"
      }
    },
    "learn-from-review-feedback": {
      "tags": [
        "Learn from past work"
      ],
      "agent": "claude",
      "model": "claude-opus-5-5",
      "skill": "tessl/learn-from-past-work#learn-from-review-feedback",
      "effort": "medium",
      "instructions": "",
      "inputs": {
        "orgId": "019f4dc3-72ed-71ec-b386-f24ff7188c49",
        "projectId": "01a1efa6-49b3-7597-8ea8-fddc778d875f"
      }
    },
    "shepherd": {
      "tags": [
        "Ticket to PR"
      ],
      "agent": "claude",
      "model": "claude-opus-5-5",
      "skill": "tessl/factory#shepherd",
      "concurrency": {
        "keys": [
          {
            "key": "github:pr:{{ inputs.GITHUB_PR_NUMBER }}",
            "limit": 1
          }
        ],
        "debounce": "90s"
      },
      "environment": "factory-tycholabs-adventurestories-shepherd"
    },
    "tune-review-lenses": {
      "tags": [
        "Learn from past work"
      ],
      "agent": "claude",
      "model": "claude-opus-5-5",
      "skill": "tessl/learn-from-past-work#tune-review-lenses",
      "effort": "medium",
      "instructions": "",
      "inputs": {
        "orgId": "019f4dc3-72ed-71ec-b386-f24ff7188c49",
        "projectId": "01a1efa6-49b3-7597-8ea8-fddc778d875f"
      }
    },
    "turn-findings-into-tickets": {
      "tags": [
        "Learn from past work"
      ],
      "agent": "claude",
      "model": "claude-opus-5-5",
      "skill": "tessl/learn-from-past-work#findings-triage",
      "effort": "medium",
      "concurrency": {
        "keys": [
          {
            "key": "turn-findings-into-tickets",
            "limit": 1
          }
        ]
      },
      "environment": "factory-tycholabs-adventurestories-implement",
      "instructions": "",
      "inputs": {
        "orgId": "019f4dc3-72ed-71ec-b386-f24ff7188c49",
        "projectId": "01a1efa6-49b3-7597-8ea8-fddc778d875f"
      }
    }
  },
  "triggers": {
    "follow-ticket-changes-issue-unlabelled": {
      "on": [
        "github:issues.unlabeled"
      ],
      "when": {
        "event.sender.id": {
          "in": [
            45830967
          ]
        },
        "event.label.name": "tessl"
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "taken-back",
          "GITHUB_ISSUE_LABEL": "tessl",
          "GITHUB_ISSUE_NUMBER": "{{ event.issue.number }}"
        }
      },
      "concurrency": {
        "keys": [
          {
            "key": "follow-ticket-changes:github-issue:{{ inputs.GITHUB_ISSUE_NUMBER }}",
            "limit": 1
          }
        ]
      }
    },
    "follow-ticket-changes-issue-closed": {
      "on": [
        "github:issues.closed"
      ],
      "when": {
        "event.sender.id": {
          "in": [
            45830967
          ]
        },
        "event.issue.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "issue-ended",
          "GITHUB_ISSUE_LABEL": "tessl",
          "GITHUB_ISSUE_NUMBER": "{{ event.issue.number }}"
        }
      },
      "concurrency": {
        "keys": [
          {
            "key": "follow-ticket-changes:github-issue:{{ inputs.GITHUB_ISSUE_NUMBER }}",
            "limit": 1
          }
        ]
      }
    },
    "follow-ticket-changes-issue-replied": {
      "on": [
        "github:issue_comment.created"
      ],
      "when": {
        "isPullRequest": "false",
        "event.sender.id": {
          "in": [
            45830967
          ]
        },
        "event.issue.state": "open",
        "event.issue.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "replied",
          "GITHUB_ISSUE_LABEL": "tessl",
          "GITHUB_ISSUE_NUMBER": "{{ event.issue.number }}"
        }
      },
      "concurrency": {
        "keys": [
          {
            "key": "implement:github-issue:{{ inputs.GITHUB_ISSUE_NUMBER }}",
            "limit": 1
          }
        ]
      }
    },
    "follow-ticket-changes-pr-closed": {
      "on": [
        "github:pull_request.closed"
      ],
      "when": {
        "event.sender.id": {
          "in": [
            45830967
          ]
        },
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "pr-closed",
          "GITHUB_PR_NUMBER": "{{ event.pull_request.number }}",
          "GITHUB_ISSUE_LABEL": "tessl"
        }
      },
      "concurrency": {
        "keys": [
          {
            "key": "follow-ticket-changes:github-pr:{{ inputs.GITHUB_PR_NUMBER }}",
            "limit": 1
          }
        ]
      }
    },
    "implement": {
      "on": [
        "github:issues.labeled"
      ],
      "when": {
        "event.label.name": "tessl"
      },
      "action": {
        "use": "implement",
        "inputs": {
          "GITHUB_ISSUE_LABEL": "tessl",
          "GITHUB_ISSUE_NUMBER": "{{ event.issue.number }}"
        }
      }
    },
    "shepherd-pr-review": {
      "on": [
        "github:pull_request_review.submitted"
      ],
      "when": {
        "event.sender.id": {
          "in": [
            45830967
          ]
        },
        "event.pull_request.state": "open",
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.pull_request.head.repo.id": 1463080427,
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "action": {
        "use": "shepherd",
        "inputs": {
          "GITHUB_PR_NUMBER": "{{ event.pull_request.number }}"
        }
      }
    },
    "shepherd-pr-review-comment": {
      "on": [
        "github:pull_request_review_comment.created"
      ],
      "when": {
        "event.sender.id": {
          "in": [
            45830967
          ]
        },
        "event.pull_request.state": "open",
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.pull_request.head.repo.id": 1463080427,
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "action": {
        "use": "shepherd",
        "inputs": {
          "GITHUB_PR_NUMBER": "{{ event.pull_request.number }}"
        }
      }
    },
    "shepherd-pr-comment": {
      "on": [
        "github:issue_comment.created"
      ],
      "when": {
        "isPullRequest": "true",
        "event.sender.id": {
          "in": [
            45830967
          ]
        },
        "event.issue.state": "open",
        "event.issue.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "action": {
        "use": "shepherd",
        "inputs": {
          "GITHUB_PR_NUMBER": "{{ event.issue.number }}"
        }
      }
    }
  },
  "schedules": {
    "learn-from-agent-runs": {
      "cron": "0 9 * * *",
      "timezone": "UTC",
      "action": "learn-from-agent-runs"
    },
    "learn-from-review-feedback": {
      "cron": "0 9 * * *",
      "timezone": "UTC",
      "action": "learn-from-review-feedback"
    },
    "tune-review-lenses": {
      "cron": "0 9 * * 1",
      "timezone": "UTC",
      "action": "tune-review-lenses"
    },
    "turn-findings-into-tickets": {
      "cron": "0 9 * * 2",
      "timezone": "UTC",
      "action": "turn-findings-into-tickets"
    }
  }
}
